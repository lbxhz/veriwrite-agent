# Required only when prepare-requirements runs in dual mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Stable JSON/structured-output model used by V0.1-V0.4 contracts.
LLM_STRUCTURED_MODEL=deepseek-chat
# Optional independent chapter-review model; defaults to LLM_STRUCTURED_MODEL.
LLM_REVIEWER_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# DeepSeek defaults to a direct connection, ignoring Windows/global proxy settings.
# Set to true only when the API itself must use the system proxy.
LLM_USE_SYSTEM_PROXY=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# Optional dedicated directory scanned for user-downloaded core PDFs.
# Defaults to ~/Documents/VeriWrite/Evidence-Vault.
VERIWRITE_EVIDENCE_VAULT=

# Optional independent hermes-rubric evaluator. The MCP client pins the judge
# model to deepseek-chat and can reuse LLM_API_KEY/LLM_BASE_URL when unset.
VW_EVAL_API_KEY=
VW_EVAL_BASE_URL=https://api.deepseek.com
VW_EVAL_MODEL=deepseek-chat
VW_EVAL_TEMPERATURE=0.0
# Defaults to LLM_USE_SYSTEM_PROXY when omitted.
VW_EVAL_USE_SYSTEM_PROXY=false
VW_EVAL_BATCH=1
VW_EVAL_TARGET_WINDOW_BYTES=120000
VW_EVAL_MAX_FULL_DOCUMENT_BYTES=160000
